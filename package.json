{
  "name": "malkamali-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "start": "bun run dev",
    "build": "bun --bun vite build && bun scripts/static-routes.js",
    "preview": "bun scripts/serve.js",
    "test": "bun test",
    "check": "bun test && bun run build",
    "test:browser": "bun scripts/browser-check.ts",
    "benchmark:nn": "bun scripts/benchmark-nn.ts",
    "benchmark:build": "bun --bun vite build --config benchmarks/vite.config.js",
    "predeploy": "bun run check",
    "deploy": "bun --bun gh-pages -d build --nojekyll",
    "format": "bun --bun prettier --write src scripts tests benchmarks vite.config.js index.html",
    "format:check": "bun --bun prettier --check src scripts tests benchmarks vite.config.js index.html"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tensorflow/tfjs": "4.22.0",
    "gh-pages": "6.3.0",
    "mathjs": "^15.2.0",
    "prettier": "3.8.1",
    "puppeteer-core": "^25.11.0",
    "vite": "^7.3.1"
  }
}
